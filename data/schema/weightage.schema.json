{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weightage.schema.json",
  "title": "Exam weightage file (editable source)",
  "description": "One file per exam in data/weightage/exams/. References syllabus IDs; never redefines syllabus content. Edit `custom` (not `default`) to change a weight; keep siblings summing to 100.",
  "type": "object",
  "required": ["examId", "syllabusCycle", "lastUpdated", "tracks", "stages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "examId": { "type": "string" },
    "syllabusCycle": { "type": "string" },
    "lastUpdated": { "$ref": "#/$defs/date" },
    "tracks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/track" } },
    "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "weight": {
      "type": "object",
      "required": ["default", "custom", "basis", "isOfficial", "confidence", "justification", "evidence", "lastUpdated"],
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/pct", "description": "Seeded value. Do not hand-edit; use `custom`." },
        "custom": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pct" }], "description": "User override; when set it replaces `default` everywhere." },
        "basis": { "enum": ["official-marks", "pyq-estimate", "proxy-estimate", "editorial-estimate", "nominal", "custom"] },
        "isOfficial": { "type": "boolean" },
        "confidence": { "enum": ["high", "medium", "low", "very-low"] },
        "justification": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "lastUpdated": { "$ref": "#/$defs/date" },
        "customNote": { "type": "string", "description": "Why the custom value was set (recommended whenever `custom` is non-null)." }
      }
    },
    "track": {
      "type": "object",
      "required": ["trackId", "name", "default", "stageWeights"],
      "additionalProperties": false,
      "properties": {
        "trackId": { "type": "string" },
        "name": { "type": "string" },
        "default": { "type": "boolean" },
        "stageWeights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stageId", "gate", "weight"],
            "additionalProperties": false,
            "properties": { "stageId": { "type": "string" }, "gate": { "type": "boolean" }, "weight": { "$ref": "#/$defs/weight" } }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["stageId", "gate", "sections"],
      "additionalProperties": false,
      "properties": {
        "stageId": { "type": "string" },
        "gate": { "type": "boolean" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["sectionId", "gate", "weight", "topics"],
      "additionalProperties": false,
      "properties": {
        "sectionId": { "type": "string" },
        "gate": { "type": "boolean" },
        "choiceGroup": { "type": "string" },
        "weight": { "$ref": "#/$defs/weight" },
        "topics": { "type": "array", "items": { "$ref": "#/$defs/topic" } }
      }
    },
    "topic": {
      "type": "object",
      "required": ["topicId", "weight", "expectedQuestions", "trend", "customPriority", "subtopicWeighting", "subtopics"],
      "additionalProperties": false,
      "properties": {
        "topicId": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
        "weight": { "$ref": "#/$defs/weight" },
        "expectedQuestions": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["min", "max", "perPaper"],
              "additionalProperties": false,
              "properties": { "min": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 }, "perPaper": { "type": ["number", "null"] }, "note": { "type": "string" } }
            }
          ],
          "description": "Estimated questions per paper (range). Estimate, not official."
        },
        "trend": { "enum": ["consistent", "fluctuating", "emerging", "declining", "new-pattern", "not-applicable"] },
        "note": { "type": "string" },
        "customPriority": { "oneOf": [{ "type": "null" }, { "enum": ["Very High", "High", "Medium", "Low"] }] },
        "subtopicWeighting": {
          "type": "object",
          "required": ["basis", "justification", "lastUpdated"],
          "additionalProperties": false,
          "properties": {
            "basis": { "enum": ["official-marks", "pyq-estimate", "proxy-estimate", "editorial-estimate", "nominal", "custom"] },
            "justification": { "type": "string" },
            "lastUpdated": { "$ref": "#/$defs/date" }
          }
        },
        "subtopics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slug", "default", "custom"],
            "additionalProperties": false,
            "properties": {
              "slug": { "type": "string" },
              "default": { "$ref": "#/$defs/pct" },
              "custom": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pct" }] }
            }
          }
        }
      }
    }
  }
}
