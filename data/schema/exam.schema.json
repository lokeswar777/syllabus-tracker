{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exam.schema.json",
  "title": "Exam syllabus file (source format)",
  "description": "One file per exam. Topics are references into data/library/topics.json; scripts/build.mjs resolves them into dist/syllabus.json.",
  "type": "object",
  "required": ["id", "name", "shortName", "conductingBody", "category", "cycle", "lastVerified", "sources", "stages"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "shortName": { "type": "string" },
    "conductingBody": { "type": "string" },
    "category": { "type": "string", "description": "Must match a category id in registry.json" },
    "cycle": { "type": "string", "description": "Notification cycle the pattern is taken from, e.g. '2026' or '2026-27'" },
    "eligibilityLevel": { "type": "string" },
    "lastVerified": { "type": "string", "format": "date" },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "posts": { "type": "array", "items": { "type": "string" } },
    "selectionSummary": { "type": "string" },
    "finalMerit": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } }
  },
  "additionalProperties": false,
  "$defs": {
    "status": { "enum": ["official", "official-umbrella", "pyq-derived", "unverified"] },
    "nature": { "enum": ["qualifying", "merit", "mandatory-unscored"] },
    "slugList": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
    "sourceRef": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string" }, "locator": { "type": "string" } },
      "additionalProperties": false
    },
    "pattern": {
      "type": "object",
      "properties": {
        "questions": { "type": ["integer", "null"] },
        "marks": { "type": ["number", "null"] },
        "durationMinutes": { "type": ["integer", "null"] },
        "negativeMarking": {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["absolute", "fraction-of-question"] },
            "value": { "type": "number" },
            "appliesTo": { "type": "string" }
          },
          "additionalProperties": false
        },
        "sectionalTiming": { "type": "string" },
        "medium": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["id", "name", "order", "mode", "nature", "sections"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["cbt", "physical", "medical", "interview", "assessment", "language-test", "descriptive"] },
        "nature": { "$ref": "#/$defs/nature" },
        "natureNote": { "type": "string" },
        "applicableTo": { "type": "array", "items": { "type": "string" } },
        "pattern": { "$ref": "#/$defs/pattern" },
        "source": { "$ref": "#/$defs/sourceRef" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "questions": { "type": ["integer", "null"] },
        "questionsDerived": { "type": "boolean", "description": "true when the count is inferred (e.g. from marks), not stated officially" },
        "marks": { "type": ["number", "null"] },
        "durationMinutes": { "type": ["integer", "null"] },
        "nature": { "$ref": "#/$defs/nature" },
        "natureNote": { "type": "string" },
        "applicableTo": { "type": "array", "items": { "type": "string" } },
        "choiceGroup": { "type": "string", "description": "Sections sharing a choiceGroup are alternatives (candidate takes one); totals count one" },
        "officialLevel": { "type": "string" },
        "officialSyllabus": { "type": ["string", "null"], "description": "Official syllabus text (verbatim/condensed). null = notification gives only the section name" },
        "topics": { "type": "array", "items": { "$ref": "#/$defs/topicRef" } }
      },
      "additionalProperties": false
    },
    "topicRef": {
      "type": "object",
      "required": ["topic", "status"],
      "properties": {
        "topic": { "type": "string", "description": "Topic id from the library, e.g. 'quant.percentage'" },
        "status": { "$ref": "#/$defs/status" },
        "officialLabel": { "type": "string", "description": "Exact official wording this topic maps to" },
        "only": { "$ref": "#/$defs/slugList", "description": "Include only these subtopic slugs" },
        "exclude": { "$ref": "#/$defs/slugList", "description": "Exclude these subtopic slugs" },
        "verbatim": { "$ref": "#/$defs/slugList", "description": "Subtopics explicitly named in official text → status 'official'" },
        "subtopicStatus": { "$ref": "#/$defs/status", "description": "Default status for subtopics not listed in 'verbatim'" },
        "override": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": { "status": { "$ref": "#/$defs/status" }, "note": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
