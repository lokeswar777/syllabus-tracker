{
  "name": "syllabus-tracker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Competitive exam syllabus tracker: syllabus database (Phase 1), exam-wise weightage (Phase 2) and the progress calculation engine (Phase 3) for SSC & Banking.",
  "main": "src/progress/index.js",
  "scripts": {
    "build:data": "node scripts/build.mjs",
    "check:data": "node scripts/build.mjs --check",
    "seed:weightage": "node scripts/build.mjs && node scripts/seed-weightage.mjs",
    "build:weightage": "node scripts/build-weightage.mjs",
    "check:weightage": "node scripts/build.mjs && node scripts/build-weightage.mjs --check",
    "build": "node scripts/build.mjs && node scripts/build-weightage.mjs",
    "check": "node scripts/build.mjs && node scripts/build-weightage.mjs --check",
    "test": "node scripts/build.mjs && node scripts/build-weightage.mjs && node --test \"test/**/*.test.mjs\"",
    "test:progress": "node --test \"test/progress/*.test.mjs\"",
    "demo:progress": "node scripts/progress-demo.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
