# Copy this file to .env.local and fill in both values from Supabase:
# Project Settings > API (or the project's Connect dialog).
# Use the publishable (or anon) key. Never put the secret or service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
